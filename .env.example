# ── Database ──────────────────────────────────────────────────────────────────
# Local: leave blank → uses SQLite (shopee_data.db)
# Production: paste Pooler URI from Supabase (port 6543, IPv4-friendly)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── GoLogin ───────────────────────────────────────────────────────────────────
GOLOGIN_TOKEN=your_gologin_api_token_here
GOLOGIN_PROFILES_DIR=C:\Users\SATHAPORN\AppData\Roaming\GoLogin\profiles

# ── Shopee target pages (Thai locale) ─────────────────────────────────────────
SHOPEE_AFFILIATE_URL=https://affiliate.shopee.co.th/dashboard
SHOPEE_LIVE_ADS_URL=https://creator.shopee.co.th/insight/live-ads

# ── Default workspace/group for rows that don't specify one in profiles.json ─
DEFAULT_GROUP=kshomeaxie29

# ── Scraper tunables ──────────────────────────────────────────────────────────
CONCURRENCY=1
NAV_TIMEOUT_MS=30000
LABEL_WAIT_MS=15000
