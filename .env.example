# ── Database ──────────────────────────────────────────────────────────────────
# Local: leave blank → uses SQLite (shopee_data.db)
# Production (Supabase): paste the "Connection string (URI)" from Supabase dashboard
#   Project Settings → Database → Connection string → URI
DATABASE_URL=

# ── GoLogin ───────────────────────────────────────────────────────────────────
GOLOGIN_TOKEN=your_gologin_api_token_here

# ── Scraper tunables ──────────────────────────────────────────────────────────
CONCURRENCY=5
NAV_TIMEOUT_MS=15000
SHOPEE_DASHBOARD_URL=https://seller.shopee.com/
